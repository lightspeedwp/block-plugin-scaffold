{
	"$comment": "Standard toolchain for generated plugins (spec 003). Proven in lightspeedwp/ls-test; generatePackageJson() and generateComposerJson() read this file.",
	"engines": {
		"node": ">=24.18.0",
		"npm": ">=11.16.0"
	},
	"scripts": {
		"standard": [
			"start",
			"build",
			"format",
			"lint:js",
			"lint:css",
			"lint:pkg",
			"test:unit",
			"test:e2e",
			"packages-update",
			"zip"
		],
		"all": {
			"build": "wp-scripts build --experimental-modules",
			"format": "wp-scripts format",
			"lint": "npm run lint:js && npm run lint:css && npm run lint:pkg",
			"lint:css": "wp-scripts lint-style",
			"lint:js": "wp-scripts lint-js",
			"lint:pkg": "wp-scripts lint-pkg-json",
			"packages-update": "wp-scripts packages-update",
			"prepare": "husky",
			"start": "wp-scripts start --experimental-modules",
			"test": "npm run test:unit",
			"test:e2e": "wp-scripts test-playwright",
			"test:unit": "wp-scripts test-unit-js",
			"zip": "wp-scripts plugin-zip",
			"env:start": "wp-env start",
			"env:stop": "wp-env stop"
		}
	},
	"lintStaged": {
		"*.{js,jsx,mjs,cjs}": [
			"wp-scripts lint-js --fix",
			"wp-scripts format"
		],
		"*.{css,scss}": [
			"wp-scripts lint-style --fix"
		],
		"*.php": [
			"composer run lint:fix"
		],
		"package.json": [
			"wp-scripts lint-pkg-json"
		]
	},
	"dependencies": {
		"@wordpress/a11y": "^4.57.0",
		"@wordpress/api-fetch": "^7.57.0",
		"@wordpress/block-editor": "^18.1.0",
		"@wordpress/blocks": "^16.2.0",
		"@wordpress/components": "^42.0.0",
		"@wordpress/compose": "^8.10.0",
		"@wordpress/core-data": "^8.2.0",
		"@wordpress/data": "^10.57.0",
		"@wordpress/dataviews": "^20.0.0",
		"@wordpress/element": "^9.0.0",
		"@wordpress/hooks": "^4.57.0",
		"@wordpress/i18n": "^6.30.0",
		"@wordpress/icons": "^18.0.0",
		"@wordpress/interactivity": "^7.0.0",
		"@wordpress/interactivity-router": "^2.57.0",
		"@wordpress/style-engine": "^2.57.0",
		"@wordpress/url": "^4.57.0"
	},
	"devDependencies": {
		"@playwright/test": "^1.64.1",
		"@testing-library/dom": "^10.4.2",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.3",
		"@vitejs/plugin-react-swc": "^4.3.3",
		"@wordpress/e2e-test-utils-playwright": "^3.0.0",
		"@wordpress/env": "^11.17.0",
		"@wordpress/scripts": "^36.1.0",
		"glob": "^13.0.6",
		"husky": "^9.1.7",
		"jsdom": "^30.1.3",
		"lint-staged": "^17.6.0",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"vite": "^8.3.4",
		"vitest": "^5.0.5"
	},
	"providedBy": {
		"@wordpress/eslint-plugin": "@wordpress/scripts",
		"@wordpress/stylelint-config": "@wordpress/scripts",
		"@wordpress/prettier-config": "@wordpress/scripts",
		"@wordpress/npm-package-json-lint-config": "@wordpress/scripts",
		"@wordpress/dependency-extraction-webpack-plugin": "@wordpress/scripts",
		"@wordpress/babel-preset-default": "@wordpress/scripts",
		"@wordpress/browserslist-config": "@wordpress/scripts",
		"@wordpress/postcss-plugins-preset": "@wordpress/scripts",
		"npm-package-json-lint": "@wordpress/scripts"
	},
	"composer": {
		"require-dev": {
			"phpunit/phpunit": "^11.5",
			"wp-coding-standards/wpcs": "^3.0",
			"dealerdirect/phpcodesniffer-composer-installer": "^1.0",
			"phpstan/phpstan": "^2.2",
			"szepeviktor/phpstan-wordpress": "^2.0",
			"yoast/phpunit-polyfills": "^4.0",
			"brain/monkey": "^2.6"
		},
		"scripts": {
			"lint": "phpcs",
			"lint:fix": "phpcbf",
			"phpstan": "phpstan analyse --memory-limit=1G",
			"test": "phpunit"
		}
	}
}
