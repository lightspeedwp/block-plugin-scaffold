{
	"$schema": "https://json.schemastore.org/tsconfig",
	"compilerOptions": {
		"allowJs": true,
		"checkJs": false,
		"jsx": "react-jsx",
		"module": "esnext",
		"moduleResolution": "bundler",
		"target": "es2022",
		"lib": [ "dom", "dom.iterable", "es2022" ],
		"noEmit": true,
		"skipLibCheck": true,
		"strict": false
	},
	"include": [ "src", "test", "tools", "*.js", "*.mjs" ],
	"exclude": [ "build", "dist", "node_modules", "vendor" ]
}
