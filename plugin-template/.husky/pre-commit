# Pre-commit gates, in order: branch name, changelog entry, build, then
# lint-staged (block.json schema check and the linters, on staged files).
# Skip them all with `git commit --no-verify`.

fail() {
	echo "pre-commit: $1" >&2
	exit 1
}

# 1. Branch name: {type}/{scope}-{title} with an organisation type, and not
# main, develop or release/*. See bin/check-branch-name.js.
reason=$(node bin/check-branch-name.js 2>&1) || fail "$reason"

staged=$(git diff --cached --name-only)

# 2. A code change needs a new CHANGELOG.md entry under [Unreleased] (or a
# new version section, when a release moves the entries) in the same commit.
changelog_items() {
	awk '
		/^## \[/ { unreleased = /^## \[Unreleased\]/; if (!unreleased) print; next }
		unreleased && /^[[:space:]]*- [^[:space:]]/ { sub(/^[[:space:]]+/, ""); print }
	'
}
if echo "$staged" | grep -qE '\.(php|js|jsx|ts|tsx|scss)$'; then
	before=$(mktemp)
	git show HEAD:CHANGELOG.md 2>/dev/null | changelog_items >"$before" || true
	added=$(git show :CHANGELOG.md 2>/dev/null | changelog_items | grep -vxF -f "$before" || true)
	rm -f "$before"
	[ -n "$added" ] ||
		fail "code changed without a new CHANGELOG.md entry. Add one under [Unreleased]."
fi

# 3. Source changes must still build.
if echo "$staged" | grep -q '^src/'; then
	npm run build --silent || fail "npm run build failed."
fi

# 4. Schema validation and linters on the staged files.
npx lint-staged
