{
	"$schema": "https://json.schemastore.org/claude-code-settings.json",
	"hooks": {
		"PreToolUse": [
			{
				"matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit",
				"hooks": [
					{
						"type": "command",
						"command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check-branch.mjs",
						"timeout": 15
					}
				]
			}
		]
	},
	"extraKnownMarketplaces": {
		"lightspeedwp": {
			"source": {
				"source": "github",
				"repo": "lightspeedwp/ls-claude-agents-router"
			}
		}
	},
	"enabledPlugins": {
		"ls-claude-agents-router@lightspeedwp": true
	}
}
